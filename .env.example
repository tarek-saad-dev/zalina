# Zalina Arabian Village — frontend env
#
# Production (Vercel Production):
#   NEXT_PUBLIC_API_BASE_URL=https://api.zalinaarabianvillage.com
#   NEXT_PUBLIC_PAYMENT_GATEWAY=paymob
#
# Preview / demo (Vercel Preview):
#   NEXT_PUBLIC_API_BASE_URL=<API host where Mock Gateway is enabled>
#   NEXT_PUBLIC_PAYMENT_GATEWAY=mock
#
# Local development:
#   NEXT_PUBLIC_API_BASE_URL=https://api.zalinaarabianvillage.com
#   NEXT_PUBLIC_PAYMENT_GATEWAY=mock
#
# Gateway values: mock | paymob
# Missing/invalid → paymob (safe default). Not derived from NODE_ENV.
#
NEXT_PUBLIC_API_BASE_URL=https://api.zalinaarabianvillage.com
NEXT_PUBLIC_PAYMENT_GATEWAY=mock
#
# Paymob return URL (configure on API / Paymob dashboard — not sent from POST /pay):
# Prefer:  {SITE_ORIGIN}/booking/{booking_reference}
# Fallback: {SITE_ORIGIN}/booking  (recovers reference from session handoff)
#
# Backend mock-pay may not redirect the browser back; after demo payment,
# open /booking/{reference} (or /booking with handoff) to poll confirmation.
