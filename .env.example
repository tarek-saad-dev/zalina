# Zalina Arabian Village public API
NEXT_PUBLIC_API_BASE_URL=https://api.zalinaarabianvillage.com
# Local/testing only: mock | paymob. Production browser flow always forces paymob.
NEXT_PUBLIC_PAYMENT_GATEWAY=mock
#
# Paymob / backend frontend return (configure server-side / Paymob dashboard — not sent from /pay):
# Prefer:  {SITE_ORIGIN}/booking/{booking_reference}
# Fallback: {SITE_ORIGIN}/booking  (recovers reference from session handoff)
# Frontend Booking Domain V2 contract does not document return_url on POST /pay.
#
# Local mock-pay has NO browser return redirect (webhook-only). Frontend lands on
# /booking/{reference} after /pay, stashes mock checkout URL ephemerally, and shows
# a Complete payment control on the status page (does not race window.open).
#
# Known production issue: POST …/pay with gateway=paymob may return 500 until Paymob
# server credentials/integration are fixed on the API host (see backend logs / trace_id).
